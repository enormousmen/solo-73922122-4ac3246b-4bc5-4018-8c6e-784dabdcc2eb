{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "web-lb",
    "namespace": "shop"
  },
  "spec": {
    "type": "LoadBalancer",
    "externalTrafficPolicy": "Local",
    "ports": [
      {
        "name": "http",
        "port": 80,
        "targetPort": 8080,
        "protocol": "TCP"
      },
      {
        "name": "metrics",
        "port": 9100,
        "targetPort": "metrics-port",
        "protocol": "TCP"
      }
    ]
  }
}
